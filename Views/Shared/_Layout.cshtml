<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Books</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header><a asp-controller="Books" asp-action="Index" class="brand">books<span>.</span></a><a asp-controller="Books" asp-action="Index">The collection</a></header>
    <main>
        @if (TempData["Success"] is string success)
        {
            <div class="notice success" role="status">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="notice error" role="alert">@error</div>
        }
        @RenderBody()
    </main>
    <footer>A small collection for curious minds.</footer>
</body>
</html>
